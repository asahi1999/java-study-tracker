{
  "name": "java-study-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "ブラウザで Java を書いて動かし、出力の文字でダンジョンを描いて学ぶアプリ",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vite --open",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run content:build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "npm run content:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:teavm": "vitest run --config vitest.teavm.config.ts",
    "e2e:build": "node scripts/content-build.ts --content tests/content-fixtures/good && vite build --outDir .cache/e2e-dist --emptyOutDir && node scripts/content-build.ts",
    "e2e": "npm run e2e:build && playwright test",
    "content:build": "node scripts/content-build.ts",
    "content:verify": "node scripts/content-verify.ts",
    "teavm:verify": "node scripts/teavm-verify.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "@fontsource/dotgothic16": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.73.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
