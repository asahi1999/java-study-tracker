{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // scripts/ から Node で直接読む src のファイル（content/・domain/・runtime/java/core/）は、
    // 型を取り除くだけで動く書き方にし、相対パスの import に .ts を付ける（設計書 2-2）
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"]
}
