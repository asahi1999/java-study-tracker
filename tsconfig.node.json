{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // vite.config.ts から scripts/lib/csp.ts を拡張子つきで読む
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "vitest.teavm.config.ts", "playwright.config.ts"]
}
