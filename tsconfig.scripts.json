{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Node 24 で .ts を直接動かす（型の除去）ため、型を取り除くだけで動く書き方に限る
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts"]
}
